{
  "name": "baku-picah",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BAKU PICAH — Fighter desktop app (Electron)",
  "author": "BAKU PICAH Team",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "vite build && electron-builder --win"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "pinia": "^2.2.2",
    "vue": "^3.4.38",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "id.bakupicah.fighter",
    "productName": "BAKU PICAH",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "BAKU-PICAH-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BAKU PICAH",
      "artifactName": "BAKU-PICAH-${version}-setup.${ext}"
    }
  }
}
