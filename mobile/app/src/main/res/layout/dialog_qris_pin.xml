<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/bp_badge_verified" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QRIS OTOMATIS STANDAR BI"
                android:textColor="@color/bp_login_accent"
                android:textSize="10sp"
                app:fontFamily="@font/inter_bold" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Konfirmasi Pembayaran"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@color/bp_border" />

    <!-- Detail Tagihan Fix -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bp_btn_circle_secondary"
        android:backgroundTint="#1F2024"
        android:orientation="vertical"
        android:padding="14dp">

        <com.google.android.material.textview.MaterialTextView
            style="@style/TextAppearance.BP.Login.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Merchant: BAKU PICAH ESCROW"
            android:textColor="@color/bp_login_muted"
            android:textSize="11sp" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/TextAppearance.BP.Login.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="NMID: ID1024098129031"
            android:textColor="@color/bp_login_muted"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nominal Tagihan (Fix)"
                app:fontFamily="@font/inter_semibold" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 160.000"
                android:textColor="@color/bp_login_accent"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- PIN Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.BP.Field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Masukkan PIN / Password (6 Digit)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:inputType="numberPassword"
            android:letterSpacing="0.3"
            android:maxLength="6"
            android:textColor="@color/bp_login_text"
            android:textSize="20sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textview.MaterialTextView
        style="@style/TextAppearance.BP.Login.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Contoh PIN demo: 123456"
        android:textColor="@color/bp_login_muted"
        android:textSize="11sp" />

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmPin"
        style="@style/Widget.BP.Login.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Bayar Sekarang (Rp 160.000)" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelPin"
        style="@style/Widget.BP.Login.Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Batal" />

</LinearLayout>
