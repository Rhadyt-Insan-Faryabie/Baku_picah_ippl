<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRecoveryBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recovery_back"
            android:padding="13dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/bp_login_arrow_left" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recovery_section"
                android:textColor="@color/bp_login_accent"
                android:textSize="11sp"
                app:fontFamily="@font/inter_bold"
                app:lineHeight="13sp" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/recovery_title"
                app:lineHeight="29.4sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRecoveryMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/recovery_more"
            android:padding="13dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/bp_login_more" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/recovery_heading"
                android:textSize="44sp"
                app:lineHeight="46.2sp" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/recovery_subtitle"
                app:lineHeight="21sp" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/etEmail"
                android:text="@string/recovery_email_label"
                app:lineHeight="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    style="@style/TextAppearance.BP.Login.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bp_login_input"
                    android:hint="@string/recovery_email_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:minHeight="52dp"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="14dp"
                    android:singleLine="true"
                    android:textColorHint="@color/bp_login_muted" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/bp_login_mail" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                style="@style/Widget.BP.Login.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/recovery_send"
                app:icon="@drawable/bp_recovery_send"
                app:iconGravity="textStart"
                app:iconSize="20dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvRecoveryStatus"
                style="@style/TextAppearance.BP.Login.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/bp_login_accent"
                android:visibility="gone"
                app:lineHeight="21sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bp_recovery_card"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recovery_card_title"
                    android:textSize="13sp"
                    app:fontFamily="@font/inter_semibold"
                    app:lineHeight="19.5sp" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/recovery_card_body"
                    app:lineHeight="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bp_login_guidance"
                android:gravity="top"
                android:minHeight="60dp"
                android:orientation="horizontal"
                android:padding="12dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/bp_login_lock" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recovery_privacy"
                    app:lineHeight="18sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tvBack"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/inter_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:minHeight="52dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/recovery_back"
                android:textAllCaps="false"
                android:textColor="@color/bp_login_text"
                android:textSize="14sp"
                app:cornerRadius="6dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
