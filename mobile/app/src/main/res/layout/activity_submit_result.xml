<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_bg"
    android:orientation="vertical">

    <!-- App Header with Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBackResult"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="11dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/bp_login_arrow_left" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KIRIM HASIL BOUT · STATUS RESMI"
                android:textColor="@color/bp_login_accent"
                android:textSize="11sp"
                app:fontFamily="@font/inter_bold" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Hasil Pertandingan"
                android:textSize="26sp"
                app:lineHeight="28sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bp_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hasil akan ditinjau dan dikonfirmasi kedua pihak sebelum masuk ke rekor resmi."
                android:textColor="@color/bp_login_muted"
                android:textSize="12sp"
                app:lineHeight="16sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.BP.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Pemenang (Saya / Lawan / Draw / No Contest)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/bp_login_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.BP.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Metode (Decision / KO / TKO / Submission / DSQ)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMethod"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/bp_login_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.BP.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Ronde Berakhir">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/bp_login_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Rating Sportivitas Lawan"
                app:fontFamily="@font/inter_semibold" />

            <RatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:numStars="5"
                android:rating="5"
                android:stepSize="1" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.BP.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Catatan Pertandingan (opsional)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2"
                    android:textColor="@color/bp_login_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                style="@style/Widget.BP.Login.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="Kirim Hasil Pertandingan" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
