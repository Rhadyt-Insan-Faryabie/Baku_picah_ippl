<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_bg"
    android:orientation="vertical">

    <!-- App Header (Figma 3:656) with Back Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="11dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/bp_login_arrow_left" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvEyebrow"
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THE HAMMER · AKTIF SEKARANG"
                android:textColor="@color/bp_login_accent"
                android:textSize="11sp"
                app:fontFamily="@font/inter_bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvOpponentName"
                style="@style/TextAppearance.BP.Login.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ardi Saputra"
                android:textSize="26sp"
                app:lineHeight="28sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu Obrolan"
            android:padding="11dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/bp_login_more" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bp_border" />

    <!-- Chat Messages Scroll Area -->
    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Sparring Agreement Banner (Figma 3:663) -->
            <LinearLayout
                android:id="@+id/layoutAgreementCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bp_badge_match"
                        android:paddingStart="9dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="5dp">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/TextAppearance.BP.Login.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KESEPAKATAN SPARRING"
                            android:textColor="@color/bp_login_accent"
                            android:textSize="10sp"
                            app:fontFamily="@font/inter_semibold" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/bp_welcome_shield" />
                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tvAgreementStatus"
                    style="@style/TextAppearance.BP.Login.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Belum ada jadwal terkonfirmasi"
                    android:textSize="13sp"
                    app:fontFamily="@font/inter_semibold" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ajukan proposal untuk menyepakati venue, aturan, dan komitmen."
                    android:textColor="@color/bp_login_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Date separator -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="Hari Ini"
                android:textColor="@color/bp_login_muted"
                android:textSize="10sp" />

            <!-- Dynamic & Interactive Message List -->
            <LinearLayout
                android:id="@+id/messageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Inbound Message 1 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card"
                    android:maxWidth="280dp"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Halo! Aku tertarik sparring boxing terkontrol. Beratku 64,5 kg."
                        android:textSize="13sp" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="10:34"
                        android:textColor="@color/bp_login_muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Outbound Message 1 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bp_btn_circle_secondary"
                    android:backgroundTint="@color/bp_blood"
                    android:maxWidth="280dp"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Siap, aku 64 kg. 3 ronde × 2 menit, headguard dan pelatih ya."
                        android:textColor="@color/bp_white"
                        android:textSize="13sp" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="4dp"
                        android:text="10:36  ✓✓"
                        android:textColor="#FFCCCC"
                        android:textSize="9sp" />
                </LinearLayout>

                <!-- Inbound Message 2 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_card"
                    android:maxWidth="280dp"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cocok. Sabtu 24 Oktober jam 16.00 WIB di Garuda Boxing?"
                        android:textSize="13sp" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="10:42"
                        android:textColor="@color/bp_login_muted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action Button: Propose Match (Figma 3:713) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProposeMatch"
                style="@style/Widget.BP.Login.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="Propose Match / Jadwalkan bout"
                app:icon="@drawable/bp_ic_calendar"
                app:iconGravity="textStart" />

            <!-- Footer note -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Menu obrolan: laporkan atau blokir fighter"
                android:textColor="@color/bp_login_muted"
                android:textSize="10sp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Message Composer (Figma 3:716) -->
    <LinearLayout
        android:id="@+id/layoutComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bp_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnAddMedia"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Unggah Foto"
            android:padding="9dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/bp_ic_camera" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bp_login_input"
            android:hint="Tulis pesan…"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/bp_login_text"
            android:textColorHint="@color/bp_login_muted"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/btnSend"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bp_btn_circle_secondary"
            android:backgroundTint="@color/bp_blood">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/bp_recovery_send" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
