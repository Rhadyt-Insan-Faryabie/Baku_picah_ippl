<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_bg"
    android:orientation="vertical">

    <!-- App Header (Figma 3:570) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RESPEK DIMULAI DARI OBROLAN"
                android:textColor="@color/bp_login_accent"
                android:textSize="11sp"
                app:fontFamily="@font/inter_bold" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="MATCH &amp; PESAN"
                android:textSize="28sp"
                app:lineHeight="30sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSearchMatches"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cari Obrolan"
            android:padding="11dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/bp_ic_search_user" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Filter Choices Row (Figma 3:576) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Chip: Semua -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/chipFilterAll"
                        style="@style/TextAppearance.BP.Login.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bp_btn_circle_secondary"
                        android:backgroundTint="@color/bp_blood"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:text="Semua 3"
                        android:textColor="@color/bp_white"
                        android:textSize="12sp"
                        app:fontFamily="@font/inter_semibold" />

                    <!-- Chip: Belum dibaca -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/chipFilterUnread"
                        style="@style/TextAppearance.BP.Login.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:text="Belum dibaca 1"
                        android:textColor="@color/bp_login_muted"
                        android:textSize="12sp"
                        app:fontFamily="@font/inter_semibold" />

                    <!-- Chip: Tantangan -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/chipFilterChallenges"
                        style="@style/TextAppearance.BP.Login.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_card"
                        android:paddingStart="14dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="8dp"
                        android:text="Tantangan"
                        android:textColor="@color/bp_login_muted"
                        android:textSize="12sp"
                        app:fontFamily="@font/inter_semibold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Incoming Challenge Card (Figma 3:583) -->
            <LinearLayout
                android:id="@+id/layoutIncomingChallenge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bp_badge_match"
                        android:paddingStart="9dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="5dp">

                        <com.google.android.material.textview.MaterialTextView
                            style="@style/TextAppearance.BP.Login.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TANTANGAN BARU"
                            android:textColor="@color/bp_login_accent"
                            android:textSize="10sp"
                            app:fontFamily="@font/inter_semibold" />
                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvIncomingCount"
                        style="@style/TextAppearance.BP.Login.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="1 menunggu"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Opponent info row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bp_card_portrait_placeholder">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivIncomingAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            app:srcCompat="@drawable/bp_welcome_training" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvIncomingName"
                            style="@style/TextAppearance.BP.Login.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Deni “Southpaw”"
                            android:textSize="14sp"
                            app:fontFamily="@font/inter_semibold" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvIncomingSpecs"
                            style="@style/TextAppearance.BP.Login.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Boxing · 64 kg · Cimahi"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewChallenge"
                        style="@style/Widget.BP.Login.Button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Lihat tantangan"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDismissChallenge"
                        style="@style/Widget.BP.Login.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Lewati"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Section: OBROLANMU Header (Figma 3:598) -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="OBROLANMU"
                android:textSize="26sp" />

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/progressBarMatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:indeterminateTint="@color/bp_login_accent"
                android:visibility="gone" />

            <!-- Conversations list (Figma 3:599) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvConversations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyMatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:alpha="0.4"
                    app:srcCompat="@drawable/bp_ic_search_user" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Belum ada lawan yang match"
                    app:fontFamily="@font/inter_semibold" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Jelajahi tab Temukan dan tantang petarung yang cocok denganmu!" />
            </LinearLayout>

            <!-- Footer Guidance (Figma 3:631) -->
            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Hanya mutual match yang bisa mengirim pesan. Laporkan atau blokir dari menu obrolan."
                android:textColor="@color/bp_login_muted"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
