<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_bg"
    android:orientation="vertical">

    <!-- App Header with Back Button (Figma 3:808) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBackDeposit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:padding="11dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/bp_login_arrow_left" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESCROW RESMI · JAMINAN KOMITMEN"
                android:textColor="@color/bp_login_accent"
                android:textSize="11sp"
                app:fontFamily="@font/inter_bold" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Checkout Deposit"
                android:textSize="26sp"
                app:lineHeight="28sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bp_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Detail Biaya Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rincian Pembayaran"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Deposit Escrow Petarung" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp150.000"
                        app:fontFamily="@font/inter_semibold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Small"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Biaya Pemeliharaan Sistem" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp10.000"
                        app:fontFamily="@font/inter_semibold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/bp_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Tagihan (Nominal Fix)"
                        app:fontFamily="@font/inter_semibold" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvTotalAmount"
                        style="@style/TextAppearance.BP.Login.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp160.000"
                        android:textColor="@color/bp_login_accent"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- QRIS Dinamis Otomatis Card -->
            <LinearLayout
                android:id="@+id/cardQris"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="QRIS STANDAR PEMBAYARAN NASIONAL"
                        android:textColor="@color/bp_login_accent"
                        android:textSize="10sp"
                        app:fontFamily="@font/inter_bold" />

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.BP.Login.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OTOMATIS"
                        android:textColor="@color/bp_white"
                        android:textSize="10sp" />
                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="BAKU PICAH ESCROW"
                    android:textSize="16sp" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NMID: ID1024098129031 · Cetak Nominal Fix"
                    android:textColor="@color/bp_login_muted"
                    android:textSize="11sp" />

                <!-- Kode QRIS Image -->
                <ImageView
                    android:id="@+id/ivQrisCode"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="QRIS Baku Picah"
                    android:src="@drawable/bp_ic_qr_code" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bisa scan dari GoPay, OVO, Dana, ShopeePay, BCA, Mandiri"
                    android:textColor="@color/bp_login_muted"
                    android:textSize="11sp" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.BP.Login.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="⏱ Kadaluarsa dalam 14:59 menit"
                    android:textColor="@color/bp_login_accent"
                    android:textSize="11sp"
                    app:fontFamily="@font/inter_semibold" />
            </LinearLayout>

            <!-- Pay Deposit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPay"
                style="@style/Widget.BP.Login.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Scan QRIS &amp; Bayar Otomatis"
                app:icon="@drawable/bp_badge_verified"
                app:iconGravity="textStart" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Setelah scan, cukup masukkan PIN akun kamu untuk menyelesaikan transaksi."
                android:textColor="@color/bp_login_muted"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
