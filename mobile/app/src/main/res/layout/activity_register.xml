<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bp_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/register_back"
            android:padding="13dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/bp_login_arrow_left" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_section"
                android:textColor="@color/bp_login_accent"
                android:textSize="11sp"
                app:fontFamily="@font/inter_bold"
                app:lineHeight="13sp" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/register_title"
                app:lineHeight="29.4sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRegisterMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/register_more"
            android:padding="13dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/bp_login_more" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="84dp"
                android:text="@string/register_heading"
                android:textSize="40sp"
                app:lineHeight="42sp" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="21dp"
                android:text="@string/register_subtitle"
                app:lineHeight="21sp" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/etName"
                android:minHeight="18dp"
                android:text="@string/register_name_label"
                app:lineHeight="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etName"
                    style="@style/TextAppearance.BP.Login.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="personName"
                    android:background="@drawable/bp_login_input"
                    android:hint="@string/register_name_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName|textCapWords"
                    android:minHeight="52dp"
                    android:nextFocusForward="@id/etEmail"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="14dp"
                    android:singleLine="true"
                    android:textColorHint="@color/bp_login_muted" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/bp_register_user" />
            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/etEmail"
                android:minHeight="18dp"
                android:text="@string/register_email_label"
                app:lineHeight="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    style="@style/TextAppearance.BP.Login.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:background="@drawable/bp_login_input"
                    android:hint="@string/register_email_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:minHeight="52dp"
                    android:nextFocusForward="@id/etPassword"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="14dp"
                    android:singleLine="true"
                    android:textColorHint="@color/bp_login_muted" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="14dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/bp_login_mail" />
            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/etPassword"
                android:minHeight="18dp"
                android:text="@string/register_password_label"
                app:lineHeight="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    style="@style/TextAppearance.BP.Login.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:background="@drawable/bp_login_input"
                    android:hint="@string/register_password_hint"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:minHeight="52dp"
                    android:nextFocusForward="@id/etConfirmPassword"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="14dp"
                    android:singleLine="true"
                    android:textColorHint="@color/bp_login_muted" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/register_show_password"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/bp_login_eye_off" />
            </FrameLayout>

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:labelFor="@id/etPassword"
                android:minHeight="17dp"
                android:text="@string/register_password_guidance"
                android:textSize="11sp"
                app:lineHeight="16.5sp" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/TextAppearance.BP.Login.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:labelFor="@id/etConfirmPassword"
                android:minHeight="18dp"
                android:text="@string/register_confirm_label"
                app:lineHeight="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    style="@style/TextAppearance.BP.Login.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:background="@drawable/bp_login_input"
                    android:hint="@string/register_confirm_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:minHeight="52dp"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="48dp"
                    android:paddingBottom="14dp"
                    android:singleLine="true"
                    android:textColorHint="@color/bp_login_muted" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnToggleConfirmPassword"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/register_show_confirm_password"
                    android:padding="15dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/bp_login_eye_off" />
            </FrameLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbConsent"
                style="@style/TextAppearance.BP.Login.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:buttonTint="@color/bp_register_checkbox"
                android:checked="false"
                android:focusableInTouchMode="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/register_consent"
                android:textSize="11sp"
                app:buttonTint="@color/bp_register_checkbox"
                app:useMaterialThemeColors="false"
                app:lineHeight="16.5sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegister"
                style="@style/Widget.BP.Login.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/register_submit"
                app:icon="@drawable/bp_login_arrow_right"
                app:iconGravity="textStart" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/bp_login_border"
                android:importantForAccessibility="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoogle"
                style="@style/Widget.BP.Login.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/register_google"
                app:icon="@drawable/bp_login_google"
                app:iconGravity="textStart" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvLogin"
                style="@style/TextAppearance.BP.Login.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:text="@string/register_login_link"
                app:lineHeight="18sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
